# Turn on the live WooCommerce Store API integration.
# Leave unset/false to run against the seeded mock (instant, no backend needed).
WOOCOMMERCE_ENABLED=false

# Base URL of the WooCommerce instance (no trailing slash).
# Local Docker:          http://localhost:8080
# Inside docker-compose: http://wordpress:80
WOOCOMMERCE_URL=http://localhost:8080

# How long (ms) to wait on the store before falling back to the mock.
WOOCOMMERCE_TIMEOUT_MS=2500

# Optional: override the checkout page URL (defaults to {WOOCOMMERCE_URL}/checkout).
# Use this if the checkout page has a custom slug or lives on a subdomain.
# WOOCOMMERCE_CHECKOUT_URL=https://store.yourdomain.com/checkout

# ---- Seeding the live store (scripts/seed-live-store.mjs) ----
# WooCommerce REST API key with Read/Write permission, created in WP admin:
#   WooCommerce → Settings → Advanced → REST API → Add key.
# Only needed to seed the full 8×10 catalog into a live store; never commit real
# values — keep them in .env.local (gitignored) and revoke the key when done.
# WOO_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# WOO_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
